$BaseUrl   = "https://example.com"
$CaptchaUrl = "$BaseUrl/"
$LoginUrl   = "$BaseUrl/login"

$Attempts = 10

# Session (VERY IMPORTANT)
$Session = New-Object Microsoft.PowerShell.Commands.WebRequestSession

$Headers = @{
    "User-Agent" = "Mozilla/5.0"
}

# -------------------------
# STEP 1: GET captcha page
# -------------------------
$Initial = Invoke-WebRequest `
    -Uri $CaptchaUrl `
    -Method GET `
    -WebSession $Session `
    -Headers $Headers

# Extract ASP.NET hidden fields (if present)
$ViewState        = ($Initial.InputFields | Where-Object { $_.Name -eq "__VIEWSTATE" }).Value
$EventValidation  = ($Initial.InputFields | Where-Object { $_.Name -eq "__EVENTVALIDATION" }).Value
$ViewStateGen     = ($Initial.InputFields | Where-Object { $_.Name -eq "__VIEWSTATEGENERATOR" }).Value

# -------------------------
# STEP 2: Submit captcha + dropdown
# -------------------------
# Replace these with REAL field names from DevTools
$CaptchaFieldName  = "recaptcha"
$DropdownFieldName = "yourDropdownFieldName"

$CaptchaBody = @{
    "__VIEWSTATE"            = $ViewState
    "__EVENTVALIDATION"      = $EventValidation
    "__VIEWSTATEGENERATOR"   = $ViewStateGen

    $DropdownFieldName = "Yes"
    $CaptchaFieldName  = "YOUR_STATIC_RECAPTCHA_VALUE"
}

$CaptchaSubmit = Invoke-WebRequest `
    -Uri $CaptchaUrl `
    -Method POST `
    -WebSession $Session `
    -Headers $Headers `
    -Body $CaptchaBody `
    -ContentType "application/x-www-form-urlencoded"

Write-Host "Captcha submit status: $($CaptchaSubmit.StatusCode)"

# -------------------------
# STEP 3: Access login page
# -------------------------
$LoginPage = Invoke-WebRequest `
    -Uri $LoginUrl `
    -Method GET `
    -WebSession $Session `
    -Headers $Headers

Write-Host "Login page status: $($LoginPage.StatusCode)"

# Extract hidden fields again (login page has its own)
$LoginViewState       = ($LoginPage.InputFields | Where-Object { $_.Name -eq "__VIEWSTATE" }).Value
$LoginEventValidation = ($LoginPage.InputFields | Where-Object { $_.Name -eq "__EVENTVALIDATION" }).Value
$LoginViewStateGen    = ($LoginPage.InputFields | Where-Object { $_.Name -eq "__VIEWSTATEGENERATOR" }).Value

# -------------------------
# STEP 4: Perform login attempts
# -------------------------
$EmailField    = "ct100`$SiteContentPlaceHolder`$txbEmal"
$PasswordField = "ct100`$SiteContentPlaceHolder`$txbPassword"

for ($i = 1; $i -le $Attempts; $i++) {

    $LoginBody = @{
        "__VIEWSTATE"            = $LoginViewState
        "__EVENTVALIDATION"      = $LoginEventValidation
        "__VIEWSTATEGENERATOR"   = $LoginViewStateGen

        $EmailField    = "test@example.com"
        $PasswordField = "WrongPassword123!"
    }

    try {
        $Response = Invoke-WebRequest `
            -Uri $LoginUrl `
            -Method POST `
            -WebSession $Session `
            -Headers $Headers `
            -Body $LoginBody `
            -ContentType "application/x-www-form-urlencoded" `
            -ErrorAction Stop

        Write-Host "Login attempt $i - Status: $($Response.StatusCode)"
    }
    catch {
        if ($_.Exception.Response) {
            $StatusCode = [int]$_.Exception.Response.StatusCode
            Write-Host "Login attempt $i - Status: $StatusCode"
        }
        else {
            Write-Host "Login attempt $i - Error: $($_.Exception.Message)"
        }
    }
}
