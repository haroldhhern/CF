# Test-RateLimit.ps1

$Url = "https://example.com/login"

# Number of login POSTs to send
$Attempts = 12

# Delay between attempts
$DelaySeconds = 1

# Replace these with your actual form field names
$TextField    = "NAME HERE"

$Text = "TEST"

for ($i = 1; $i -le $Attempts; $i++) {

    $Body = @{
        $TextField    = $Text
    }

    try {
        $Response = Invoke-WebRequest `
            -Uri $Url `
            -Method POST `
            -Body $Body `
            -ContentType "application/x-www-form-urlencoded" `
            -MaximumRedirection 0 `
            -ErrorAction Stop

        Write-Host "Attempt $i - Status: $($Response.StatusCode)"
    }
    catch {
        if ($_.Exception.Response) {
            $StatusCode = [int]$_.Exception.Response.StatusCode
            Write-Host "Attempt $i - Status: $StatusCode"
        }
        else {
            Write-Host "Attempt $i - Error: $($_.Exception.Message)"
        }
    }

    Start-Sleep -Seconds $DelaySeconds
}
