$BaseUrl  = "https://example.com"
$GateUrl  = "$BaseUrl/"
$LoginUrl = "$BaseUrl/login"

$Attempts = 10
$DelayBetweenLoginAttemptsSeconds = 1

$Session = New-Object Microsoft.PowerShell.Commands.WebRequestSession

$Headers = @{
    "User-Agent" = "Mozilla/5.0"
    "Accept"     = "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
    "Origin"     = $BaseUrl
    "Referer"    = $GateUrl
}

# Replace with exact values from DevTools payload
$DropdownFieldName = 'yourDropdownFieldName'
$DropdownValue     = 'Yes'

$CaptchaFieldName  = 'recaptcha'
$CaptchaValue      = 'YOUR_STATIC_RECAPTCHA_VALUE'

# Use exact value from DevTools if present
$GateEventTarget   = 'yourGateEventTarget'

# Use exact image button base name from DevTools if payload shows .x and .y
$GateImageButton   = 'yourGateImageButtonName'

$EmailFieldName    = 'ct100$SiteContentPlaceHolder$txbEmal'
$PasswordFieldName = 'ct100$SiteContentPlaceHolder$txbPassword'

$EmailValue        = 'test@example.com'
$PasswordValue     = 'WrongPassword123!'

# Use exact value from DevTools if present
$LoginEventTarget  = 'yourLoginEventTarget'

# Use exact image button base name from DevTools if payload shows .x and .y
$LoginImageButton  = 'yourLoginImageButtonName'

function Get-HiddenFields {
    param($Page)

    $Hidden = @{}

    foreach ($FieldName in @(
        "__VIEWSTATE",
        "__VIEWSTATEGENERATOR",
        "__EVENTVALIDATION",
        "__EVENTTARGET",
        "__EVENTARGUMENT",
        "__VIEWSTATEENCRYPTED"
    )) {
        $Value = ($Page.InputFields | Where-Object { $_.Name -eq $FieldName }).Value

        if ($null -ne $Value) {
            $Hidden[$FieldName] = $Value
        }
    }

    if (-not $Hidden.ContainsKey("__EVENTTARGET")) {
        $Hidden["__EVENTTARGET"] = ""
    }

    if (-not $Hidden.ContainsKey("__EVENTARGUMENT")) {
        $Hidden["__EVENTARGUMENT"] = ""
    }

    return $Hidden
}

function Show-Step {
    param(
        [string]$Label,
        $Response
    )

    Write-Host ""
    Write-Host "===== $Label ====="
    Write-Host "Status: $($Response.StatusCode)"
    Write-Host "Final URL: $($Response.BaseResponse.ResponseUri.AbsoluteUri)"

    Write-Host "Cookies:"
    $CookieUri = New-Object System.Uri("$BaseUrl/")
    $Session.Cookies.GetCookies($CookieUri) |
        Format-Table Name, Domain, Path
}

# STEP 1: GET initial gate page
$GatePage = Invoke-WebRequest `
    -Uri $GateUrl `
    -Method GET `
    -WebSession $Session `
    -Headers $Headers

Show-Step -Label "Initial gate page" -Response $GatePage

# STEP 2: Select dropdown first
$DropdownBody = Get-HiddenFields -Page $GatePage
$DropdownBody[$DropdownFieldName] = $DropdownValue

# If DevTools shows an event target for the dropdown, replace this value
# Otherwise leave it blank
# $DropdownBody["__EVENTTARGET"] = $DropdownFieldName
# $DropdownBody["__EVENTARGUMENT"] = ""

$Headers["Referer"] = $GateUrl

$DropdownSubmit = Invoke-WebRequest `
    -Uri $GateUrl `
    -Method POST `
    -WebSession $Session `
    -Headers $Headers `
    -Body $DropdownBody `
    -ContentType "application/x-www-form-urlencoded"

Show-Step -Label "Dropdown submit" -Response $DropdownSubmit

# STEP 3: Wait for application-side dropdown load behavior
Start-Sleep -Seconds 5

# STEP 4: Submit CAPTCHA and click gate image button
$GateSubmitBody = Get-HiddenFields -Page $DropdownSubmit
$GateSubmitBody[$DropdownFieldName] = $DropdownValue
$GateSubmitBody[$CaptchaFieldName]  = $CaptchaValue

# Only use this if DevTools shows __EVENTTARGET populated
if ($GateEventTarget -ne 'yourGateEventTarget') {
    $GateSubmitBody["__EVENTTARGET"] = $GateEventTarget
    $GateSubmitBody["__EVENTARGUMENT"] = ""
}

# Only use this if DevTools payload shows imageButton.x and imageButton.y
if ($GateImageButton -ne 'yourGateImageButtonName') {
    $GateSubmitBody["$GateImageButton.x"] = "12"
    $GateSubmitBody["$GateImageButton.y"] = "8"
}

$GateSubmit = Invoke-WebRequest `
    -Uri $GateUrl `
    -Method POST `
    -WebSession $Session `
    -Headers $Headers `
    -Body $GateSubmitBody `
    -ContentType "application/x-www-form-urlencoded"

Show-Step -Label "Captcha/image button submit" -Response $GateSubmit

# STEP 5: GET login page after gate is passed
$Headers["Referer"] = $GateUrl

$LoginPage = Invoke-WebRequest `
    -Uri $LoginUrl `
    -Method GET `
    -WebSession $Session `
    -Headers $Headers

Show-Step -Label "Login page GET" -Response $LoginPage

if ($LoginPage.BaseResponse.ResponseUri.AbsoluteUri -like "*sessiontimedout*" -or
    $LoginPage.BaseResponse.ResponseUri.AbsoluteUri -like "*errorpage*") {
    Write-Host ""
    Write-Host "The gate flow was not accepted. Compare the gate POST payload with DevTools."
    exit
}

# STEP 6: Submit repeated login attempts
$Headers["Referer"] = $LoginUrl

for ($i = 1; $i -le $Attempts; $i++) {

    $LoginBody = Get-HiddenFields -Page $LoginPage

    $LoginBody[$EmailFieldName]    = $EmailValue
    $LoginBody[$PasswordFieldName] = $PasswordValue

    # Only use this if DevTools shows __EVENTTARGET populated
    if ($LoginEventTarget -ne 'yourLoginEventTarget') {
        $LoginBody["__EVENTTARGET"] = $LoginEventTarget
        $LoginBody["__EVENTARGUMENT"] = ""
    }

    # Only use this if DevTools payload shows imageButton.x and imageButton.y
    if ($LoginImageButton -ne 'yourLoginImageButtonName') {
        $LoginBody["$LoginImageButton.x"] = "25"
        $LoginBody["$LoginImageButton.y"] = "10"
    }

    try {
        $Response = Invoke-WebRequest `
            -Uri $LoginUrl `
            -Method POST `
            -WebSession $Session `
            -Headers $Headers `
            -Body $LoginBody `
            -ContentType "application/x-www-form-urlencoded" `
            -ErrorAction Stop

        Write-Host "Login attempt $i - Status: $($Response.StatusCode) - Final URL: $($Response.BaseResponse.ResponseUri.AbsoluteUri)"
    }
    catch {
        if ($_.Exception.Response) {
            $StatusCode = [int]$_.Exception.Response.StatusCode
            Write-Host "Login attempt $i - Status: $StatusCode"
        }
        else {
            Write-Host "Login attempt $i - Error: $($_.Exception.Message)"
        }
    }

    Start-Sleep -Seconds $DelayBetweenLoginAttemptsSeconds
}
