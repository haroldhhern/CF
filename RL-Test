$BaseUrl    = "https://example.com"
$CaptchaUrl = "$BaseUrl/"
$LoginUrl   = "$BaseUrl/login"

$Attempts = 10

$Session = New-Object Microsoft.PowerShell.Commands.WebRequestSession

$Headers = @{
    "User-Agent" = "Mozilla/5.0"
}

# Replace with exact values from DevTools → Network → Payload/Form Data
$DropdownFieldName = 'yourDropdownFieldName'
$DropdownValue     = 'Yes'

$CaptchaFieldName  = 'recaptcha'
$CaptchaValue      = 'YOUR_STATIC_RECAPTCHA_VALUE'

$CaptchaImageButton = 'ct100$SiteContentPlaceHolder$imgCaptchaSubmit'

$EmailFieldName    = 'ct100$SiteContentPlaceHolder$txbEmal'
$PasswordFieldName = 'ct100$SiteContentPlaceHolder$txbPassword'

$EmailValue        = 'test@example.com'
$PasswordValue     = 'WrongPassword123!'

$LoginImageButton  = 'ct100$SiteContentPlaceHolder$imgLogin'

function Get-HiddenFields {
    param($Page)

    $Hidden = @{}

    foreach ($FieldName in @(
        "__VIEWSTATE",
        "__EVENTVALIDATION",
        "__VIEWSTATEGENERATOR",
        "__EVENTTARGET",
        "__EVENTARGUMENT"
    )) {
        $Value = ($Page.InputFields | Where-Object { $_.Name -eq $FieldName }).Value
        if ($null -ne $Value) {
            $Hidden[$FieldName] = $Value
        }
    }

    return $Hidden
}

# STEP 1: Load initial page
$Initial = Invoke-WebRequest `
    -Uri $CaptchaUrl `
    -Method GET `
    -WebSession $Session `
    -Headers $Headers

Write-Host "Initial page status: $($Initial.StatusCode)"
Write-Host "Initial final URL: $($Initial.BaseResponse.ResponseUri.AbsoluteUri)"

# STEP 2: Submit/select dropdown first
$DropdownBody = Get-HiddenFields -Page $Initial
$DropdownBody[$DropdownFieldName] = $DropdownValue

$DropdownSubmit = Invoke-WebRequest `
    -Uri $CaptchaUrl `
    -Method POST `
    -WebSession $Session `
    -Headers $Headers `
    -Body $DropdownBody `
    -ContentType "application/x-www-form-urlencoded"

Write-Host "Dropdown submit status: $($DropdownSubmit.StatusCode)"
Write-Host "Dropdown final URL: $($DropdownSubmit.BaseResponse.ResponseUri.AbsoluteUri)"

Start-Sleep -Seconds 5

# STEP 3: Submit CAPTCHA value and click CAPTCHA image button
$CaptchaBody = Get-HiddenFields -Page $DropdownSubmit
$CaptchaBody[$DropdownFieldName] = $DropdownValue
$CaptchaBody[$CaptchaFieldName]  = $CaptchaValue

# Simulate image button click
$CaptchaBody["$CaptchaImageButton.x"] = "12"
$CaptchaBody["$CaptchaImageButton.y"] = "8"

$CaptchaSubmit = Invoke-WebRequest `
    -Uri $CaptchaUrl `
    -Method POST `
    -WebSession $Session `
    -Headers $Headers `
    -Body $CaptchaBody `
    -ContentType "application/x-www-form-urlencoded"

Write-Host "Captcha submit status: $($CaptchaSubmit.StatusCode)"
Write-Host "Captcha final URL: $($CaptchaSubmit.BaseResponse.ResponseUri.AbsoluteUri)"

# STEP 4: Load login page
$LoginPage = Invoke-WebRequest `
    -Uri $LoginUrl `
    -Method GET `
    -WebSession $Session `
    -Headers $Headers

Write-Host "Login page status: $($LoginPage.StatusCode)"
Write-Host "Login page final URL: $($LoginPage.BaseResponse.ResponseUri.AbsoluteUri)"

# STEP 5: Send repeated login attempts and click login image button
for ($i = 1; $i -le $Attempts; $i++) {

    $LoginBody = Get-HiddenFields -Page $LoginPage

    $LoginBody[$EmailFieldName]    = $EmailValue
    $LoginBody[$PasswordFieldName] = $PasswordValue

    # Simulate login image button click
    $LoginBody["$LoginImageButton.x"] = "25"
    $LoginBody["$LoginImageButton.y"] = "10"

    try {
        $Response = Invoke-WebRequest `
            -Uri $LoginUrl `
            -Method POST `
            -WebSession $Session `
            -Headers $Headers `
            -Body $LoginBody `
            -ContentType "application/x-www-form-urlencoded" `
            -ErrorAction Stop

        Write-Host "Login attempt $i - Status: $($Response.StatusCode)"
        Write-Host "Login attempt $i - Final URL: $($Response.BaseResponse.ResponseUri.AbsoluteUri)"
    }
    catch {
        if ($_.Exception.Response) {
            $StatusCode = [int]$_.Exception.Response.StatusCode
            Write-Host "Login attempt $i - Status: $StatusCode"
        }
        else {
            Write-Host "Login attempt $i - Error: $($_.Exception.Message)"
        }
    }
}
