/*
================================================================================
 DEBUG MODE INSTRUCTIONS
================================================================================

To debug, do the following:

1. Temporarily set:
       const DEBUG_MODE = true;

2. Append ?sia_debug=1 to ANY URI:
       https://<your-domain>/<any-path>?sia_debug=1

3. When finished debugging:
       Set DEBUG_MODE = false

================================================================================
 ROUTE  (<your-domain>/*)
================================================================================

This Worker is safe for a catch-all route (<your-domain>/*) because it includes
a loop guard:

- If a request already has X-SIAList-Worker: 1, the Worker bypasses its logic
  and immediately fetches origin. This prevents accidental recursion/loops.
*/

const DEBUG_MODE = false; // Enable debugging ONLY when needed

export default {
  async fetch(request, env) {
    // Loop guard — prevents Worker recursion on catch-all routes
    if (request.headers.get("X-SIAList-Worker") === "1") {
      return fetch(request);
    }

    const ipHeader = request.headers.get("CF-Connecting-IP") || "";
    const ipRaw = ipHeader.toLowerCase();
    const ip = ipRaw.includes(":") ? normalizeIPv6(ipRaw) : ipRaw;
    const url = new URL(request.url);

    let ptr = null;

    try {
      ptr = await getPtr(ipRaw);
    } catch (e) {
      ptr = null;
    }

    // Evaluate SIAList against SIAList_trusted_clients
    const siaTrust = await getTrustFlags(env.SIAList_trusted_clients, ip, ipRaw, ptr);
    const siaApproved = siaTrust.trustedByIp || siaTrust.trustedByPtr;
    const siaValue = siaApproved ? "approve" : "deny";

    // Evaluate CLList against CLList_trusted_clients
    const clTrust = await getTrustFlags(env.CLList_trusted_clients, ip, ipRaw, ptr);
    const clApproved = clTrust.trustedByIp || clTrust.trustedByPtr;
    const clValue = clApproved ? "approve" : "deny";

    // Debug wrapper
    if (DEBUG_MODE && url.searchParams.get("sia_debug") === "1") {
      const debugBody = {
        ip,
        ipRaw,
        ptr,
        SIAList: {
          headerValue: siaValue,
          trustedByIp: siaTrust.trustedByIp,
          trustedByPtr: siaTrust.trustedByPtr,
          kvBound: siaTrust.kvBound,
          matchedKey: siaTrust.matchedKey,
          matchedValue: siaTrust.matchedValue
        },
        CLList: {
          headerValue: clValue,
          trustedByIp: clTrust.trustedByIp,
          trustedByPtr: clTrust.trustedByPtr,
          kvBound: clTrust.kvBound,
          matchedKey: clTrust.matchedKey,
          matchedValue: clTrust.matchedValue
        }
      };

      return new Response(JSON.stringify(debugBody, null, 2), {
        status: 200,
        headers: { "content-type": "application/json" }
      });
    }

    // Always forward to origin. Backend enforces based on SIAList / CLList.
    const originRequestHeaders = new Headers(request.headers);

    // mark request as already processed by Worker
    originRequestHeaders.set("X-SIAList-Worker", "1");

    // Decision headers sent to origin
    originRequestHeaders.set("SIAList", siaValue);
    originRequestHeaders.set("CLList", clValue);

    const originRequest = new Request(request, {
      headers: originRequestHeaders
    });

    return fetch(originRequest);
  }
};

async function getTrustFlags(kv, ip, ipRaw, ptr) {
  const out = {
    trustedByIp: false,
    trustedByPtr: false,
    kvBound: false,
    matchedKey: null,
    matchedValue: null
  };

  if (!kv) return out;
  out.kvBound = true;

  // IP: exact + CIDR
  if (ip) {
    // 1) Exact IP matches
    const candidates = [];
    candidates.push(`ip:${ip}`);
    if (ipRaw !== ip) candidates.push(`ip:${ipRaw}`);

    for (const key of candidates) {
      const vIp = await kv.get(key);
      if (vIp !== null) {
        const normVal = vIp.trim().toLowerCase();
        if (normVal === "1" || normVal === "true") {
          out.trustedByIp = true;
          out.matchedKey = key;
          out.matchedValue = vIp;
          return out;
        }
      }
    }

    // 2) CIDR matches
    let cursor;
    do {
      const listResp = await kv.list({ prefix: "ip:", cursor });

      for (const entry of listResp.keys) {
        const key = entry.name;
        const raw = key.slice(3);

        if (!raw.includes("/")) continue;

        const parts = raw.split("/");
        if (parts.length !== 2) continue;

        const cidrIp = parts[0];
        const prefix = parseInt(parts[1], 10);
        if (Number.isNaN(prefix)) continue;

        const isCidrV6 = cidrIp.includes(":");
        const isClientV6 = ip.includes(":");

        if (isCidrV6 !== isClientV6) continue;

        const inRange = isCidrV6
          ? ipv6InCidr(ip, cidrIp, prefix)
          : ip4InCidr(ip, cidrIp, prefix);

        if (!inRange) continue;

        const vCidr = await kv.get(key);
        if (vCidr !== null) {
          const normVal = vCidr.trim().toLowerCase();
          if (normVal === "1" || normVal === "true") {
            out.trustedByIp = true;
            out.matchedKey = key;
            out.matchedValue = vCidr;
            return out;
          }
        }
      }

      cursor = listResp.list_complete ? undefined : listResp.cursor;
    } while (cursor);
  }

  // PTR: exact + leading-dot suffix
  if (ptr) {
    // 1) Exact PTR hostname
    let ptrKey = `ptr:${ptr}`;
    const vFull = await kv.get(ptrKey);
    if (vFull !== null) {
      const norm = vFull.trim().toLowerCase();
      if (norm === "1" || norm === "true") {
        out.trustedByPtr = true;
        out.matchedKey = ptrKey;
        out.matchedValue = vFull;
        return out;
      }
    }

    // 2) Suffix wildcards: ptr:.<suffix>
    const hostParts = ptr.toLowerCase().split(".");
    for (let i = 1; i < hostParts.length - 1; i++) {
      const suffix = hostParts.slice(i).join(".");
      ptrKey = `ptr:.${suffix}`;

      const vSuffix = await kv.get(ptrKey);
      if (vSuffix !== null) {
        const norm = vSuffix.trim().toLowerCase();
        if (norm === "1" || norm === "true") {
          out.trustedByPtr = true;
          out.matchedKey = ptrKey;
          out.matchedValue = vSuffix;
          return out;
        }
      }
    }
  }

  return out;
}

async function getPtr(ip) {
  if (!ip) return null;

  const queryName = ip.includes(":") ? ip6ToArpa(ip) : ip4ToArpa(ip);

  const resp = await fetch(
    `https://cloudflare-dns.com/dns-query?name=${encodeURIComponent(queryName)}&type=PTR`,
    { headers: { accept: "application/dns-json" } }
  );

  if (!resp.ok) return null;

  const json = await resp.json();
  if (!json.Answer || json.Answer.length === 0) return null;

  return json.Answer[0].data.replace(/\.$/, "");
}

function ip4ToArpa(ip) {
  const parts = ip.split(".");
  if (parts.length !== 4) return ip;
  return parts.reverse().join(".") + ".in-addr.arpa";
}

function ip6ToArpa(ip) {
  const full = normalizeIPv6(ip);
  const hex = full.replace(/:/g, "");
  return hex.split("").reverse().join(".") + ".ip6.arpa";
}

// IPv6 helpers

function normalizeIPv6(ip) {
  const addr = (ip || "").toLowerCase();
  if (!addr) return "";

  if (!addr.includes("::")) {
    const parts = addr.split(":");
    if (parts.length !== 8) return addr;
    return parts.map(h => h.padStart(4, "0")).join(":");
  }

  const seg = addr.split("::");
  const headStr = seg[0] || "";
  const tailStr = seg[1] || "";

  const head = headStr ? headStr.split(":") : [];
  const tail = tailStr ? tailStr.split(":") : [];

  const missing = 8 - (head.length + tail.length);
  if (missing < 0) return addr;

  const zeros = Array(missing).fill("0");
  const full = [...head, ...zeros, ...tail];

  if (full.length !== 8) return addr;

  return full.map(h => h.padStart(4, "0")).join(":");
}

function ipv6ToBigInt(ip) {
  const full = normalizeIPv6(ip);
  const hex = full.replace(/:/g, "");
  try {
    return BigInt("0x" + hex);
  } catch {
    return null;
  }
}

function ipv6InCidr(ip, cidrIp, prefix) {
  if (prefix < 0 || prefix > 128) return false;

  const ipInt = ipv6ToBigInt(ip);
  const cidrInt = ipv6ToBigInt(cidrIp);
  if (ipInt === null || cidrInt === null) return false;

  const totalBits = 128n;
  const p = BigInt(prefix);
  const hostBits = totalBits - p;

  const allOnes128 = (1n << totalBits) - 1n;
  const mask = p === 0n ? 0n : (~((1n << hostBits) - 1n) & allOnes128);

  return (ipInt & mask) === (cidrInt & mask);
}

// IPv4 helpers

function ip4InCidr(ip, cidrIp, prefix) {
  if (prefix < 0 || prefix > 32) return false;

  const ipInt = ipv4ToInt(ip);
  const cidrInt = ipv4ToInt(cidrIp);
  if (ipInt === null || cidrInt === null) return false;

  const mask = prefix === 0 ? 0 : (~0 << (32 - prefix)) >>> 0;
  return (ipInt & mask) === (cidrInt & mask);
}

function ipv4ToInt(ip) {
  const parts = (ip || "").split(".");
  if (parts.length !== 4) return null;

  const nums = parts.map(p => parseInt(p, 10));
  if (nums.some(n => Number.isNaN(n) || n < 0 || n > 255)) return null;

  return (
    ((nums[0] << 24) >>> 0) +
    ((nums[1] << 16) >>> 0) +
    ((nums[2] << 8) >>> 0) +
    (nums[3] >>> 0)
  );
}
