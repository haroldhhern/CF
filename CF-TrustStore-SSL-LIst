
$ApiTokens = @(
    @{
        AccountLabel = "Account1"
        ApiToken     = "PASTE_API_TOKEN_1_HERE"
    },
    @{
        AccountLabel = "Account2"
        ApiToken     = "PASTE_API_TOKEN_2_HERE"
    }
)

$OutputCsvPath = ".\Cloudflare_TrustStore_Report.csv"

# ============================
# INTERNAL SETTINGS
# ============================

$BaseUrl = "https://api.cloudflare.com/client/v4"
$Results = New-Object System.Collections.Generic.List[object]

function Invoke-CFGet {
    param(
        [string]$Uri,
        [hashtable]$Headers
    )

    try {
        $response = Invoke-RestMethod -Method Get -Uri $Uri -Headers $Headers -ErrorAction Stop

        if (-not $response.success) {
            $errors = ($response.errors | ConvertTo-Json -Compress)
            throw "Cloudflare API error: $errors"
        }

        return $response
    }
    catch {
        throw $_
    }
}

# ============================
# MAIN LOGIC
# ============================

foreach ($tokenObj in $ApiTokens) {

    $AccountLabel = $tokenObj.AccountLabel
    $ApiToken     = $tokenObj.ApiToken

    $Headers = @{
        Authorization = "Bearer $ApiToken"
        "Content-Type" = "application/json"
    }

    Write-Host "`nProcessing account: $AccountLabel"

    try {
        # Get all zones (with pagination)
        $page = 1
        $perPage = 50
        $zones = @()

        do {
            $zonesUrl = "$BaseUrl/zones?page=$page&per_page=$perPage"
            $zonesResp = Invoke-CFGet -Uri $zonesUrl -Headers $Headers

            if ($zonesResp.result) {
                $zones += $zonesResp.result
            }

            $totalPages = if ($zonesResp.result_info.total_pages) {
                [int]$zonesResp.result_info.total_pages
            } else {
                1
            }

            $page++
        } while ($page -le $totalPages)

        Write-Host "  Found $($zones.Count) zones"

        foreach ($zone in $zones) {
            $zoneName = $zone.name
            $zoneId   = $zone.id

            # Use actual account name if available
            $accountName = if ($zone.account -and $zone.account.name) {
                $zone.account.name
            } else {
                $AccountLabel
            }

            try {
                $trustUrl = "$BaseUrl/zones/$zoneId/acm/custom_trust_store"
                $trustResp = Invoke-CFGet -Uri $trustUrl -Headers $Headers

                if ($trustResp.result -and $trustResp.result.Count -gt 0) {

                    foreach ($cert in $trustResp.result) {
                        $Results.Add([PSCustomObject]@{
                            AccountName              = $accountName
                            ZoneName                 = $zoneName
                            ZoneID                   = $zoneId
                            TrustStoreCertificateID  = $cert.id
                            Issuer                   = $cert.issuer
                            Subject                  = $cert.subject
                            ExpiresOn                = $cert.expires_on
                        })
                    }

                } else {
                    Write-Host "    No trust store certs in zone: $zoneName"
                }
            }
            catch {
                Write-Warning "    Failed trust store for zone '$zoneName': $($_.Exception.Message)"
            }
        }
    }
    catch {
        Write-Warning "Failed processing account '$AccountLabel': $($_.Exception.Message)"
    }
}

# ============================
# OUTPUT
# ============================

$Final = $Results | Sort-Object AccountName, ZoneName, ExpiresOn

$Final | Export-Csv -Path $OutputCsvPath -NoTypeInformation -Encoding UTF8
$Final | Format-Table -AutoSize

Write-Host "`nReport saved to: $OutputCsvPath"
