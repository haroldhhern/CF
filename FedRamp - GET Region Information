$AccountId = "YOUR_ACCOUNT_ID"
$ZoneId    = "YOUR_ZONE_ID"

$SecureToken = Read-Host "Cloudflare API token" -AsSecureString
$Token = [System.Net.NetworkCredential]::new("", $SecureToken).Password
$Headers = @{ Authorization = "Bearer $($Token.Trim())" }

$Checks = [ordered]@{
    Zone    = "zones/$ZoneId/addressing/regional_hostnames"
    Account = "accounts/$AccountId/addressing/regional_hostnames/regions"
}

foreach ($Check in $Checks.GetEnumerator()) {
    Write-Host "`n--- $($Check.Key) request ---"

    try {
        $Response = Invoke-WebRequest -UseBasicParsing `
            -Uri "https://api.cloudflare.com/client/v4/$($Check.Value)" `
            -Headers $Headers -ErrorAction Stop

        Write-Host "HTTP: $([int]$Response.StatusCode)"
        Write-Host "Ray ID: $($Response.Headers['CF-Ray'])"
        Write-Host "Body: $($Response.Content)"
    }
    catch {
        $FailedResponse = $_.Exception.Response

        if ($FailedResponse) {
            Write-Host "HTTP: $([int]$FailedResponse.StatusCode)"
            Write-Host "Ray ID: $($FailedResponse.Headers['CF-Ray'])"
        }

        Write-Host "Error: $($_.ErrorDetails.Message)"
        Write-Host "Exception: $($_.Exception.Message)"
    }
}
#####################################################################################################



$Token     = "YOUR_API_TOKEN"
$AccountId = "YOUR_ACCOUNT_ID"
$ZoneId    = "YOUR_ZONE_ID"

$Headers = @{ Authorization = "Bearer $Token" }
$BaseUrl = "https://api.cloudflare.com/client/v4"

$Regions = Invoke-RestMethod -Method Get -Headers $Headers `
    -Uri "$BaseUrl/accounts/$AccountId/addressing/regional_hostnames/regions" `
    -ErrorAction Stop

$Configured = Invoke-RestMethod -Method Get -Headers $Headers `
    -Uri "$BaseUrl/zones/$ZoneId/addressing/regional_hostnames" `
    -ErrorAction Stop

if (!$Regions.success -or !$Configured.success) {
    throw "API request failed: $(
        @($Regions.errors; $Configured.errors) | ConvertTo-Json -Depth 5
    )"
}

Write-Host "`nAvailable FedRAMP regions:"
$Regions.result |
    Where-Object { $_.label -match "FedRAMP" } |
    Format-Table key, label -AutoSize

Write-Host "`nConfigured regional hostnames:"
$Configured.result | ForEach-Object {
    $Key = $_.region_key
    [PSCustomObject]@{
        Hostname  = $_.hostname
        RegionKey = $Key
        Region    = ($Regions.result |
            Where-Object { $_.key -eq $Key }).label
    }
} | Format-Table -AutoSize
