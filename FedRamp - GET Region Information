# READ ONLY — makes no changes to Cloudflare.
# Read available regions and current configurations

$ErrorActionPreference = "Stop"

$AccountId = "YOUR_ACCOUNT_ID"
$ZoneId    = "YOUR_ZONE_ID"

$SecureToken = Read-Host "Enter your Cloudflare API token" -AsSecureString
$Headers = @{
    Authorization = "Bearer $([System.Net.NetworkCredential]::new('', $SecureToken).Password)"
}

$BaseUrl = "https://api.cloudflare.com/client/v4"

try {
    # Read available regions.
    $Regions = Invoke-RestMethod `
        -Method Get `
        -Uri "$BaseUrl/accounts/$AccountId/addressing/regional_hostnames/regions" `
        -Headers $Headers

    if (-not $Regions.success) {
        throw ($Regions.errors | ConvertTo-Json -Depth 10)
    }

    Write-Host "`nAVAILABLE REGIONS" -ForegroundColor Cyan
    $Regions.result |
        Sort-Object label |
        Format-Table key, label -AutoSize

    # Read existing regional configurations in this zone.
    $Configurations = Invoke-RestMethod `
        -Method Get `
        -Uri "$BaseUrl/zones/$ZoneId/addressing/regional_hostnames" `
        -Headers $Headers

    if (-not $Configurations.success) {
        throw ($Configurations.errors | ConvertTo-Json -Depth 10)
    }

    Write-Host "`nCURRENT REGIONAL HOSTNAME CONFIGURATIONS" -ForegroundColor Cyan

    if (@($Configurations.result).Count -eq 0) {
        Write-Host "No regional hostname configurations were returned."
    }
    else {
        $Configurations.result |
            Sort-Object hostname |
            Format-Table hostname, region_key -AutoSize
    }
}
finally {
    $Headers.Clear()
    $SecureToken = $null
}
