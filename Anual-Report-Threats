# ======================================================================
# CLOUDFLARE APPLICATION SECURITY REPORT EXPORT
#
# Reporting period:
#   October 1, 2025 through latest available Cloudflare monthly report
#
# Requirements:
#   PowerShell 5.1 or PowerShell 7+
#   Cloudflare API Token
#
# Output:
#   CloudflareSecurityReport\
#       Executive-Summary.csv
#       Monthly-Summary.csv
#       Top-Attacked-Hostnames.csv
#       Top-Mitigation-Rules.csv
#       Top-Mitigated-Countries.csv
#       Top-Served-Countries.csv
#       Zone-Inventory.csv
#       Report-Policies.json
#       Raw-All-Reports.json
#       Raw-Report-List.json
# ======================================================================


# ======================================================================
# CONFIGURATION - CHANGE THESE TWO VALUES
# ======================================================================

$AccountId = "YOUR_CLOUDFLARE_ACCOUNT_ID"
$ApiToken  = "YOUR_CLOUDFLARE_API_TOKEN"


# ======================================================================
# REPORT PERIOD
# ======================================================================

$StartDate = [datetime]"2025-10-01T00:00:00Z"
$EndDate   = (Get-Date).ToUniversalTime()


# ======================================================================
# GENERAL SETTINGS
# ======================================================================

$BaseUrl = "https://api.cloudflare.com/client/v4"

$OutputFolder = Join-Path $PWD "CloudflareSecurityReport"

$Headers = @{
    Authorization = "Bearer $ApiToken"
    Accept        = "application/json"
}


# ======================================================================
# CREATE OUTPUT FOLDER
# ======================================================================

if (-not (Test-Path $OutputFolder)) {

    New-Item `
        -Path $OutputFolder `
        -ItemType Directory `
        -Force | Out-Null
}


# ======================================================================
# CLOUDFLARE API FUNCTION
# ======================================================================

function Invoke-CloudflareGet {

    param (
        [Parameter(Mandatory = $true)]
        [string]$Uri,

        [switch]$DoNotStop
    )

    try {

        $Response = Invoke-RestMethod `
            -Method GET `
            -Uri $Uri `
            -Headers $Headers `
            -ErrorAction Stop

        if (
            $null -ne $Response.success -and
            $Response.success -eq $false
        ) {

            Write-Host ""
            Write-Host "Cloudflare API returned an error:" -ForegroundColor Red

            foreach ($ApiError in @($Response.errors)) {

                if ($null -ne $ApiError) {

                    Write-Host `
                        "  Code $($ApiError.code): $($ApiError.message)" `
                        -ForegroundColor Red
                }
            }

            return $null
        }

        return $Response
    }

    catch {

        Write-Host ""
        Write-Host "Cloudflare request failed:" -ForegroundColor Red
        Write-Host $Uri -ForegroundColor DarkYellow
        Write-Host $_.Exception.Message -ForegroundColor Red

        if (-not $DoNotStop) {
            throw
        }

        return $null
    }
}


# ======================================================================
# SAFE PROPERTY FUNCTION
#
# Returns $null when a property is absent instead of generating errors.
# ======================================================================

function Get-PropertyValue {

    param (
        $Object,

        [Parameter(Mandatory = $true)]
        [string[]]$Names
    )

    if ($null -eq $Object) {
        return $null
    }

    foreach ($Name in $Names) {

        $Property = $Object.PSObject.Properties[$Name]

        if ($null -ne $Property) {

            return $Property.Value
        }
    }

    return $null
}


# ======================================================================
# SAFE NUMBER FUNCTION
# ======================================================================

function Convert-ToLong {

    param (
        $Value
    )

    if ($null -eq $Value) {
        return [long]0
    }

    try {
        return [long]$Value
    }
    catch {
        return [long]0
    }
}


# ======================================================================
# GET COUNT FROM CLOUDFLARE COUNT/PERCENTAGE OBJECT
# ======================================================================

function Get-MetricCount {

    param (
        $Metric
    )

    if ($null -eq $Metric) {
        return [long]0
    }

    # If Cloudflare sends a raw number
    if (
        $Metric -is [int]  -or
        $Metric -is [long] -or
        $Metric -is [double]
    ) {
        return [long]$Metric
    }

    $Count = Get-PropertyValue `
        -Object $Metric `
        -Names @("count", "value")

    return Convert-ToLong $Count
}


# ======================================================================
# GET PERCENTAGE
# ======================================================================

function Get-MetricPercentage {

    param (
        $Metric
    )

    if ($null -eq $Metric) {
        return $null
    }

    return Get-PropertyValue `
        -Object $Metric `
        -Names @("percentage", "percent")
}


# ======================================================================
# HEADER
# ======================================================================

Write-Host ""
Write-Host "==========================================================" -ForegroundColor Cyan
Write-Host " CLOUDFLARE APPLICATION SECURITY REPORT" -ForegroundColor Cyan
Write-Host "==========================================================" -ForegroundColor Cyan

Write-Host ""
Write-Host "Requested period:"
Write-Host "  October 1, 2025 through $($EndDate.ToString('MMMM d, yyyy'))"
Write-Host ""


# ======================================================================
# 1. TEST ACCESS BY RETRIEVING REPORT LIST
# ======================================================================

Write-Host "[1/6] Retrieving Application Security Reports..." `
    -ForegroundColor Cyan

$ReportsUrl = "$BaseUrl/accounts/$AccountId/reporting/reports"

$ReportListResponse = Invoke-CloudflareGet `
    -Uri $ReportsUrl `
    -DoNotStop


if ($null -eq $ReportListResponse) {

    Write-Host ""
    Write-Host "FAILED TO ACCESS APPLICATION SECURITY REPORTS." `
        -ForegroundColor Red

    Write-Host ""
    Write-Host "Check:"
    Write-Host "  1. Account ID"
    Write-Host "  2. API token"
    Write-Host "  3. Application Security Reports access"
    Write-Host "  4. Enterprise account eligibility"

    Write-Host ""
    exit 1
}


# Save exactly what Cloudflare returned.

$ReportListResponse |
    ConvertTo-Json -Depth 30 |
    Out-File `
        (Join-Path $OutputFolder "Raw-Report-List.json") `
        -Encoding utf8


$ReportEntries = @()

if ($null -ne $ReportListResponse.result) {
    $ReportEntries = @($ReportListResponse.result)
}


Write-Host "      Reports found: $($ReportEntries.Count)" `
    -ForegroundColor Green


if ($ReportEntries.Count -eq 0) {

    Write-Host ""
    Write-Host "Cloudflare returned zero Application Security Reports." `
        -ForegroundColor Yellow

    Write-Host ""
    Write-Host "Raw response was saved to:"
    Write-Host (
        Join-Path $OutputFolder "Raw-Report-List.json"
    )

    exit 0
}


# ======================================================================
# 2. RETRIEVE EVERY REPORT
# ======================================================================

Write-Host ""
Write-Host "[2/6] Downloading individual monthly reports..." `
    -ForegroundColor Cyan


$AllReports = New-Object System.Collections.ArrayList


foreach ($ReportEntry in $ReportEntries) {

    if ($null -eq $ReportEntry) {
        continue
    }


    $ReportId = Get-PropertyValue `
        -Object $ReportEntry `
        -Names @(
            "id",
            "report_id",
            "reportId"
        )


    if ([string]::IsNullOrWhiteSpace([string]$ReportId)) {

        Write-Host `
            "      Skipping entry with no report ID." `
            -ForegroundColor Yellow

        continue
    }


    Write-Host "      Report: $ReportId" -ForegroundColor DarkGray


    $DetailUrl = "$BaseUrl/accounts/$AccountId/reporting/reports/$ReportId"


    $DetailResponse = Invoke-CloudflareGet `
        -Uri $DetailUrl `
        -DoNotStop


    if (
        $null -ne $DetailResponse -and
        $null -ne $DetailResponse.result
    ) {

        [void]$AllReports.Add($DetailResponse.result)
    }
}


Write-Host ""
Write-Host "      Detailed reports downloaded: $($AllReports.Count)" `
    -ForegroundColor Green


# Save EVERYTHING returned by Cloudflare.

$AllReports |
    ConvertTo-Json -Depth 50 |
    Out-File `
        (Join-Path $OutputFolder "Raw-All-Reports.json") `
        -Encoding utf8


if ($AllReports.Count -eq 0) {

    Write-Host ""
    Write-Host "No detailed reports could be downloaded." `
        -ForegroundColor Red

    exit 1
}


# ======================================================================
# 3. PROCESS REPORTS
# ======================================================================

Write-Host ""
Write-Host "[3/6] Processing security metrics..." `
    -ForegroundColor Cyan


$MonthlySummary      = New-Object System.Collections.ArrayList
$HostnameResults     = New-Object System.Collections.ArrayList
$MitigationRules     = New-Object System.Collections.ArrayList
$MitigatedCountries  = New-Object System.Collections.ArrayList
$ServedCountries     = New-Object System.Collections.ArrayList


foreach ($Report in $AllReports) {

    if ($null -eq $Report) {
        continue
    }


    # ------------------------------------------------------------------
    # TIME RANGE
    # ------------------------------------------------------------------

    $TimeRange = Get-PropertyValue `
        -Object $Report `
        -Names @(
            "time_range",
            "timeRange"
        )


    $PeriodStartRaw = $null
    $PeriodEndRaw   = $null


    if ($null -ne $TimeRange) {

        $PeriodStartRaw = Get-PropertyValue `
            -Object $TimeRange `
            -Names @(
                "start",
                "start_time",
                "from"
            )


        $PeriodEndRaw = Get-PropertyValue `
            -Object $TimeRange `
            -Names @(
                "end",
                "end_time",
                "to"
            )
    }


    # Additional fallback names

    if ($null -eq $PeriodStartRaw) {

        $PeriodStartRaw = Get-PropertyValue `
            -Object $Report `
            -Names @(
                "period_start",
                "start_time",
                "start"
            )
    }


    if ($null -eq $PeriodEndRaw) {

        $PeriodEndRaw = Get-PropertyValue `
            -Object $Report `
            -Names @(
                "period_end",
                "end_time",
                "end"
            )
    }


    $PeriodStart = $null
    $PeriodEnd   = $null


    if ($null -ne $PeriodStartRaw) {

        try {
            $PeriodStart = [datetime]$PeriodStartRaw
        }
        catch {
            $PeriodStart = $null
        }
    }


    if ($null -ne $PeriodEndRaw) {

        try {
            $PeriodEnd = [datetime]$PeriodEndRaw
        }
        catch {
            $PeriodEnd = $null
        }
    }


    # Ignore reports before October 2025.

    if (
        $null -ne $PeriodStart -and
        $PeriodStart -lt $StartDate
    ) {
        continue
    }


    # ------------------------------------------------------------------
    # ACCOUNT DATA
    # ------------------------------------------------------------------

    $ReportId = Get-PropertyValue `
        -Object $Report `
        -Names @("id", "report_id", "reportId")


    $AccountName = Get-PropertyValue `
        -Object $Report `
        -Names @("account_name", "accountName")


    $AccountIndustry = Get-PropertyValue `
        -Object $Report `
        -Names @("account_industry", "accountIndustry", "industry")


    $TotalZones = Get-PropertyValue `
        -Object $Report `
        -Names @("total_zones", "totalZones")


    $ZonesAnalyzed = Get-PropertyValue `
        -Object $Report `
        -Names @(
            "total_zones_analyzed",
            "totalZonesAnalyzed",
            "zones_analyzed"
        )


    $IndustryPercentile = Get-PropertyValue `
        -Object $Report `
        -Names @(
            "industry_percentile",
            "industryPercentile"
        )


    # ------------------------------------------------------------------
    # TOTAL REQUESTS
    # ------------------------------------------------------------------

    $TotalRequestsObject = Get-PropertyValue `
        -Object $Report `
        -Names @(
            "total_requests",
            "totalRequests"
        )


    $TotalRequests = Get-MetricCount `
        -Metric $TotalRequestsObject


    $TotalRequestPercentage = Get-MetricPercentage `
        -Metric $TotalRequestsObject


    # ------------------------------------------------------------------
    # MITIGATED
    # ------------------------------------------------------------------

    $MitigatedObject = Get-PropertyValue `
        -Object $Report `
        -Names @(
            "total_mitigated_requests",
            "totalMitigatedRequests",
            "mitigated_requests"
        )


    $MitigatedRequests = Get-MetricCount `
        -Metric $MitigatedObject


    $MitigatedPercentage = Get-MetricPercentage `
        -Metric $MitigatedObject


    # ------------------------------------------------------------------
    # SERVED
    # ------------------------------------------------------------------

    $ServedObject = Get-PropertyValue `
        -Object $Report `
        -Names @(
            "total_served_requests",
            "totalServedRequests",
            "served_requests"
        )


    $ServedRequests = Get-MetricCount `
        -Metric $ServedObject


    $ServedPercentage = Get-MetricPercentage `
        -Metric $ServedObject


    # ------------------------------------------------------------------
    # MONTHLY SUMMARY
    # ------------------------------------------------------------------

    $SummaryObject = [PSCustomObject]@{

        PeriodStart            = $PeriodStart
        PeriodEnd              = $PeriodEnd

        ReportId               = $ReportId

        AccountName            = $AccountName
        AccountIndustry        = $AccountIndustry

        TotalZones             = $TotalZones
        ZonesAnalyzed          = $ZonesAnalyzed

        IndustryPercentile     = $IndustryPercentile

        TotalRequests          = $TotalRequests
        TotalRequestPercentage = $TotalRequestPercentage

        MitigatedRequests      = $MitigatedRequests
        MitigatedPercentage    = $MitigatedPercentage

        ServedRequests         = $ServedRequests
        ServedPercentage       = $ServedPercentage
    }


    [void]$MonthlySummary.Add($SummaryObject)


    # ==================================================================
    # TOP ATTACKED HOSTNAMES
    # ==================================================================

    $HostData = Get-PropertyValue `
        -Object $Report `
        -Names @(
            "top_hostnames_by_mitigated_requests",
            "topHostnamesByMitigatedRequests"
        )


    foreach ($HostItem in @($HostData)) {

        if ($null -eq $HostItem) {
            continue
        }


        $HostName = Get-PropertyValue `
            -Object $HostItem `
            -Names @(
                "hostname",
                "host",
                "name"
            )


        $HostCount = Get-PropertyValue `
            -Object $HostItem `
            -Names @(
                "count",
                "requests",
                "value"
            )


        [void]$HostnameResults.Add(

            [PSCustomObject]@{

                PeriodStart       = $PeriodStart
                PeriodEnd         = $PeriodEnd

                Hostname          = $HostName
                MitigatedRequests = Convert-ToLong $HostCount
            }
        )
    }


    # ==================================================================
    # TOP MITIGATION RULES
    # ==================================================================

    $RulesData = Get-PropertyValue `
        -Object $Report `
        -Names @(
            "top_rules_by_mitigated_requests",
            "topRulesByMitigatedRequests"
        )


    foreach ($RuleItem in @($RulesData)) {

        if ($null -eq $RuleItem) {
            continue
        }


        $RuleName = Get-PropertyValue `
            -Object $RuleItem `
            -Names @(
                "rule_name",
                "ruleName",
                "name"
            )


        $RuleType = Get-PropertyValue `
            -Object $RuleItem `
            -Names @(
                "rule_type",
                "ruleType",
                "type"
            )


        $RuleCount = Get-PropertyValue `
            -Object $RuleItem `
            -Names @(
                "count",
                "requests",
                "value"
            )


        [void]$MitigationRules.Add(

            [PSCustomObject]@{

                PeriodStart       = $PeriodStart
                PeriodEnd         = $PeriodEnd

                RuleName          = $RuleName
                RuleType          = $RuleType
                MitigatedRequests = Convert-ToLong $RuleCount
            }
        )
    }


    # ==================================================================
    # MITIGATED COUNTRIES
    # ==================================================================

    $MitigatedCountryData = Get-PropertyValue `
        -Object $Report `
        -Names @(
            "top_source_countries_by_mitigated_requests",
            "topSourceCountriesByMitigatedRequests"
        )


    foreach ($CountryItem in @($MitigatedCountryData)) {

        if ($null -eq $CountryItem) {
            continue
        }


        $CountryName = Get-PropertyValue `
            -Object $CountryItem `
            -Names @(
                "country",
                "country_code",
                "countryCode",
                "name"
            )


        $CountryCount = Get-PropertyValue `
            -Object $CountryItem `
            -Names @(
                "count",
                "requests",
                "value"
            )


        [void]$MitigatedCountries.Add(

            [PSCustomObject]@{

                PeriodStart       = $PeriodStart
                PeriodEnd         = $PeriodEnd

                Country           = $CountryName
                MitigatedRequests = Convert-ToLong $CountryCount
            }
        )
    }


    # ==================================================================
    # SERVED COUNTRIES
    # ==================================================================

    $ServedCountryData = Get-PropertyValue `
        -Object $Report `
        -Names @(
            "top_source_countries_by_served_requests",
            "topSourceCountriesByServedRequests"
        )


    foreach ($CountryItem in @($ServedCountryData)) {

        if ($null -eq $CountryItem) {
            continue
        }


        $CountryName = Get-PropertyValue `
            -Object $CountryItem `
            -Names @(
                "country",
                "country_code",
                "countryCode",
                "name"
            )


        $CountryCount = Get-PropertyValue `
            -Object $CountryItem `
            -Names @(
                "count",
                "requests",
                "value"
            )


        [void]$ServedCountries.Add(

            [PSCustomObject]@{

                PeriodStart    = $PeriodStart
                PeriodEnd      = $PeriodEnd

                Country        = $CountryName
                ServedRequests = Convert-ToLong $CountryCount
            }
        )
    }
}


# ======================================================================
# 4. EXPORT REPORT DATA
# ======================================================================

Write-Host ""
Write-Host "[4/6] Exporting CSV files..." -ForegroundColor Cyan


if ($MonthlySummary.Count -gt 0) {

    $MonthlySummary |
        Sort-Object PeriodStart |
        Export-Csv `
            (Join-Path $OutputFolder "Monthly-Summary.csv") `
            -NoTypeInformation
}


if ($HostnameResults.Count -gt 0) {

    $HostnameResults |
        Sort-Object PeriodStart, MitigatedRequests -Descending |
        Export-Csv `
            (Join-Path $OutputFolder "Top-Attacked-Hostnames.csv") `
            -NoTypeInformation
}


if ($MitigationRules.Count -gt 0) {

    $MitigationRules |
        Sort-Object PeriodStart, MitigatedRequests -Descending |
        Export-Csv `
            (Join-Path $OutputFolder "Top-Mitigation-Rules.csv") `
            -NoTypeInformation
}


if ($MitigatedCountries.Count -gt 0) {

    $MitigatedCountries |
        Sort-Object PeriodStart, MitigatedRequests -Descending |
        Export-Csv `
            (Join-Path $OutputFolder "Top-Mitigated-Countries.csv") `
            -NoTypeInformation
}


if ($ServedCountries.Count -gt 0) {

    $ServedCountries |
        Sort-Object PeriodStart, ServedRequests -Descending |
        Export-Csv `
            (Join-Path $OutputFolder "Top-Served-Countries.csv") `
            -NoTypeInformation
}


# ======================================================================
# 5. RETRIEVE REPORT POLICIES
# ======================================================================

Write-Host ""
Write-Host "[5/6] Retrieving reporting policies..." `
    -ForegroundColor Cyan


$PoliciesResponse = Invoke-CloudflareGet `
    -Uri "$BaseUrl/accounts/$AccountId/reporting/policies" `
    -DoNotStop


if ($null -ne $PoliciesResponse) {

    $PoliciesResponse |
        ConvertTo-Json -Depth 30 |
        Out-File `
            (Join-Path $OutputFolder "Report-Policies.json") `
            -Encoding utf8
}


# ======================================================================
# 6. ZONE INVENTORY
# ======================================================================

Write-Host ""
Write-Host "[6/6] Retrieving Cloudflare zone inventory..." `
    -ForegroundColor Cyan


$Zones = New-Object System.Collections.ArrayList

$Page = 1


do {

    $ZoneUrl = `
        "$BaseUrl/zones?account.id=$AccountId&page=$Page&per_page=50"


    $ZoneResponse = Invoke-CloudflareGet `
        -Uri $ZoneUrl `
        -DoNotStop


    if ($null -eq $ZoneResponse) {
        break
    }


    foreach ($Zone in @($ZoneResponse.result)) {

        if ($null -ne $Zone) {
            [void]$Zones.Add($Zone)
        }
    }


    $TotalPages = 1


    if ($null -ne $ZoneResponse.result_info) {

        $PageValue = Get-PropertyValue `
            -Object $ZoneResponse.result_info `
            -Names @("total_pages")


        if ($null -ne $PageValue) {

            try {
                $TotalPages = [int]$PageValue
            }
            catch {
                $TotalPages = 1
            }
        }
    }


    $Page++

}
while ($Page -le $TotalPages)


$ZoneExport = New-Object System.Collections.ArrayList


foreach ($Zone in $Zones) {

    if ($null -eq $Zone) {
        continue
    }


    $PlanName = $null
    $ZoneAccountName = $null


    if ($null -ne $Zone.plan) {
        $PlanName = $Zone.plan.name
    }


    if ($null -ne $Zone.account) {
        $ZoneAccountName = $Zone.account.name
    }


    [void]$ZoneExport.Add(

        [PSCustomObject]@{

            ZoneName      = $Zone.name
            ZoneId        = $Zone.id

            Status        = $Zone.status
            Type          = $Zone.type

            Plan          = $PlanName

            CreatedOn     = $Zone.created_on
            ActivatedOn   = $Zone.activated_on
            ModifiedOn    = $Zone.modified_on

            Paused        = $Zone.paused

            AccountName   = $ZoneAccountName
        }
    )
}


if ($ZoneExport.Count -gt 0) {

    $ZoneExport |
        Sort-Object ZoneName |
        Export-Csv `
            (Join-Path $OutputFolder "Zone-Inventory.csv") `
            -NoTypeInformation
}


# ======================================================================
# TOTALS
# ======================================================================

$TotalRequests  = [long]0
$TotalMitigated = [long]0
$TotalServed    = [long]0


if ($MonthlySummary.Count -gt 0) {

    $Measurement = $MonthlySummary |
        Measure-Object TotalRequests -Sum

    if ($null -ne $Measurement.Sum) {
        $TotalRequests = [long]$Measurement.Sum
    }


    $Measurement = $MonthlySummary |
        Measure-Object MitigatedRequests -Sum

    if ($null -ne $Measurement.Sum) {
        $TotalMitigated = [long]$Measurement.Sum
    }


    $Measurement = $MonthlySummary |
        Measure-Object ServedRequests -Sum

    if ($null -ne $Measurement.Sum) {
        $TotalServed = [long]$Measurement.Sum
    }
}


$MitigationRate = 0


if ($TotalRequests -gt 0) {

    $MitigationRate = [math]::Round(
        ($TotalMitigated / $TotalRequests) * 100,
        4
    )
}


# ======================================================================
# EXECUTIVE SUMMARY
# ======================================================================

$Summary = New-Object System.Collections.ArrayList


[void]$Summary.Add(
    [PSCustomObject]@{
        Metric = "Requested Start Date"
        Value  = "2025-10-01"
    }
)


[void]$Summary.Add(
    [PSCustomObject]@{
        Metric = "Report Generated"
        Value  = $EndDate.ToString("yyyy-MM-dd")
    }
)


[void]$Summary.Add(
    [PSCustomObject]@{
        Metric = "Application Security Reports Processed"
        Value  = $MonthlySummary.Count
    }
)


[void]$Summary.Add(
    [PSCustomObject]@{
        Metric = "Cloudflare Zones"
        Value  = $Zones.Count
    }
)


[void]$Summary.Add(
    [PSCustomObject]@{
        Metric = "Total Requests"
        Value  = $TotalRequests
    }
)


[void]$Summary.Add(
    [PSCustomObject]@{
        Metric = "Total Mitigated Requests"
        Value  = $TotalMitigated
    }
)


[void]$Summary.Add(
    [PSCustomObject]@{
        Metric = "Mitigation Rate"
        Value  = "$MitigationRate%"
    }
)


[void]$Summary.Add(
    [PSCustomObject]@{
        Metric = "Total Served Requests"
        Value  = $TotalServed
    }
)


$Summary |
    Export-Csv `
        (Join-Path $OutputFolder "Executive-Summary.csv") `
        -NoTypeInformation


# ======================================================================
# SCREEN OUTPUT
# ======================================================================

Write-Host ""
Write-Host "==========================================================" -ForegroundColor Green
Write-Host " REPORT COMPLETED" -ForegroundColor Green
Write-Host "==========================================================" -ForegroundColor Green

Write-Host ""

Write-Host "Application Security reports processed : " `
    -NoNewline

Write-Host $MonthlySummary.Count -ForegroundColor Green


Write-Host "Cloudflare zones                       : " `
    -NoNewline

Write-Host $Zones.Count -ForegroundColor Green


Write-Host "Total requests                         : " `
    -NoNewline

Write-Host $TotalRequests.ToString("N0") -ForegroundColor Green


Write-Host "Mitigated requests                     : " `
    -NoNewline

Write-Host $TotalMitigated.ToString("N0") -ForegroundColor Green


Write-Host "Mitigation rate                        : " `
    -NoNewline

Write-Host "$MitigationRate%" -ForegroundColor Green


Write-Host "Served requests                        : " `
    -NoNewline

Write-Host $TotalServed.ToString("N0") -ForegroundColor Green


Write-Host ""
Write-Host "OUTPUT:" -ForegroundColor Cyan
Write-Host $OutputFolder


Write-Host ""
Write-Host "Files:" -ForegroundColor Cyan


Get-ChildItem $OutputFolder -File |
    Select-Object Name, Length |
    Format-Table -AutoSize


Write-Host ""
Write-Host "Done." -ForegroundColor Green
