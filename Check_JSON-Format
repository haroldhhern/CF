# Need to enter the file path and for Position, the line number with the error that is provided after trying to upload the json file

param(
  [Parameter(Mandatory=$true)]
  [string]$JsonFile,

  [Parameter(Mandatory=$true)]
  [int]$Position
)

if (-not (Test-Path $JsonFile)) {
  Write-Host "File not found: $JsonFile" -ForegroundColor Red
  return
}

$raw = Get-Content -Path $JsonFile -Raw

if ($Position -lt 0 -or $Position -ge $raw.Length) {
  Write-Host ("Position " + $Position + " is out of range. File length is " + $raw.Length + ".") -ForegroundColor Red
  return
}

# Split lines safely (works for CRLF and LF)
$lines = $raw -split "`n"

# Find line/column from absolute character position
$running = 0
$lineNumber = 1
$columnNumber = 1

for ($i = 0; $i -lt $lines.Count; $i++) {
  $lineText = $lines[$i]
  $lineLen = $lineText.Length
  $lineTotal = $lineLen + 1  # +1 for the '\n' removed by split

  if ($Position -lt ($running + $lineTotal)) {
    $lineNumber = $i + 1
    $columnNumber = ($Position - $running) + 1
    break
  }

  $running += $lineTotal
}

Write-Host "Approx location:" -ForegroundColor Cyan
Write-Host ("  Line   : " + $lineNumber)
Write-Host ("  Column : " + $columnNumber)
Write-Host ""

# Context range
$start = $lineNumber - 3
if ($start -lt 1) { $start = 1 }

$end = $lineNumber + 3
if ($end -gt $lines.Count) { $end = $lines.Count }

Write-Host "Context:" -ForegroundColor Cyan

for ($ln = $start; $ln -le $end; $ln++) {
  $prefix = "  "
  if ($ln -eq $lineNumber) { $prefix = ">>" }

  # Remove trailing CR if present (avoid regex; use char 13)
  $text = $lines[$ln - 1]
  if ($text.Length -gt 0 -and $text[$text.Length - 1] -eq [char]13) {
    $text = $text.Substring(0, $text.Length - 1)
  }

  Write-Host ($prefix + " " + $ln + ": " + $text)
}

Write-Host ""

# Show snippet around exact position
$win = 80
$from = $Position - $win
if ($from -lt 0) { $from = 0 }

$to = $Position + $win
if ($to -gt $raw.Length) { $to = $raw.Length }

$snippet = $raw.Substring($from, $to - $from)

Write-Host ("Snippet around position " + $Position + ":") -ForegroundColor Cyan
Write-Host $snippet
Write-Host ""
Write-Host "Marker:" -ForegroundColor Cyan

$spaces = $Position - $from
if ($spaces -lt 0) { $spaces = 0 }
Write-Host ((" " * $spaces) + "^")
