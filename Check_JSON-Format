param(
    [Parameter(Mandatory = $true)]
    [string]$JsonFile
)

if (-not (Test-Path $JsonFile)) {
    Write-Error "File not found: $JsonFile"
    exit 1
}

$raw = Get-Content -Path $JsonFile -Raw

# 1. Syntax validation
try {
    $json = $raw | ConvertFrom-Json -ErrorAction Stop
} catch {
    Write-Error "❌ Invalid JSON syntax"
    Write-Error $_.Exception.Message
    exit 1
}

# 2. Root must be an array
if ($json -isnot [System.Array]) {
    Write-Error "❌ Root JSON element must be an ARRAY: [ { ""key"": ""..."", ""value"": ""..."" } ]"
    exit 1
}

Write-Host "✔ JSON syntax valid"
Write-Host "✔ Root is array"
Write-Host "✔ Records found: $($json.Count)"
Write-Host ""

# Pre-split file into lines for line estimation
$lines = $raw -split "`r?`n"

$errors = 0

for ($i = 0; $i -lt $json.Count; $i++) {
    $item = $json[$i]

    try {
        if (-not ($item.PSObject.Properties.Name -contains "key")) {
            throw "Missing 'key'"
        }

        if (-not ($item.PSObject.Properties.Name -contains "value")) {
            throw "Missing 'value'"
        }

        if (-not ($item.key -is [string]) -or [string]::IsNullOrWhiteSpace($item.key)) {
            throw "'key' must be a non-empty string"
        }

        if ($item.value -isnot [string]) {
            throw "'value' must be a string (use `"1`", not 1)"
        }

        # Try to find approximate line number
        $pattern = [regex]::Escape($item.key)
        $lineMatch = ($lines | Select-String -Pattern $pattern | Select-Object -First 1)

        if ($lineMatch) {
            Write-Host "✔ Record #$i OK  (key='$($item.key)' at approx line $($lineMatch.LineNumber))"
        } else {
            Write-Host "✔ Record #$i OK  (key='$($item.key)', line unknown)"
        }

    } catch {
        $errors++
        Write-Host "❌ Record #$i FAILED" -ForegroundColor Red
        Write-Host "   Reason : $($_.Exception.Message)" -ForegroundColor Red
        Write-Host "   Key    : $($item.key)" -ForegroundColor Red

        $pattern = if ($item.key) { [regex]::Escape($item.key) } else { '"key"' }
        $lineMatch = ($lines | Select-String -Pattern $pattern | Select-Object -First 1)

        if ($lineMatch) {
            Write-Host "   Approx line: $($lineMatch.LineNumber)" -ForegroundColor Red
        }

        Write-Host ""
    }
}

Write-Host ""
if ($errors -eq 0) {
    Write-Host "🎉 JSON file is VALID for Cloudflare KV bulk upload" -ForegroundColor Green
} else {
    Write-Host "⚠ Found $errors invalid record(s). Fix them before uploading." -ForegroundColor Yellow
}
