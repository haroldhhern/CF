param(
  [Parameter(Mandatory = $true)]
  [string]$JsonFile,

  [Parameter(Mandatory = $true)]
  [int]$Position
)

if (-not (Test-Path $JsonFile)) {
  Write-Host "File not found: $JsonFile" -ForegroundColor Red
  return
}

$raw = Get-Content -Path $JsonFile -Raw

if ($Position -lt 0 -or $Position -ge $raw.Length) {
  Write-Host "Position $Position is out of range. File length is $($raw.Length)." -ForegroundColor Red
  return
}

# Split into lines (handles CRLF and LF)
$lines = $raw -split "`n"

# Convert absolute character position to line+column
$running = 0
$lineNumber = 1
$columnNumber = 1

for ($i = 0; $i -lt $lines.Count; $i++) {
  $lineText = $lines[$i]
  $lineLen = $lineText.Length
  $lineTotal = $lineLen + 1  # +1 for '\n'

  if ($Position -lt ($running + $lineTotal)) {
    $lineNumber = $i + 1
    $columnNumber = ($Position - $running) + 1
    break
  }

  $running += $lineTotal
}

Write-Host "Approx location:" -ForegroundColor Cyan
Write-Host "  Line   : $lineNumber"
Write-Host "  Column : $columnNumber"
Write-Host ""

# Show context around the line
$start = [Math]::Max(1, $lineNumber - 3)
$end   = [Math]::Min($lines.Count, $lineNumber + 3)

Write-Host "Context:" -ForegroundColor Cyan
for ($ln = $start; $ln -le $end; $ln++) {
  $prefix = if ($ln -eq $lineNumber) { ">>" } else { "  " }
  $text = $lines[$ln - 1] -replace "`r$", ""
  "{0} {1,6}: {2}" -f $prefix, $ln, $text
}

Write-Host ""

# Show a small snippet around the exact position with a caret marker
$win = 80
$from = [Math]::Max(0, $Position - $win)
$to   = [Math]::Min($raw.Length, $Position + $win)
$snippet = $raw.Substring($from, $to - $from)

Write-Host "Snippet around position $Position:" -ForegroundColor Cyan
Write-Host $snippet
Write-Host ""
Write-Host "Marker:" -ForegroundColor Cyan
Write-Host (" " * ($Position - $from) + "^")
