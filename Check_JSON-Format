param(
  [Parameter(Mandatory = $true)]
  [string]$JsonFile,

  [Parameter(Mandatory = $true)]
  [int]$Position
)

$raw = Get-Content -Path $JsonFile -Raw

if ($Position -lt 0 -or $Position -gt $raw.Length) {
  Write-Host "Position $Position is out of range. File length is $($raw.Length)." -ForegroundColor Red
  return
}

# Convert 0-based position to line/column (1-based for humans)
$before = $raw.Substring(0, $Position)
$line = ([regex]::Matches($before, "`r?`n")).Count + 1

# Column = chars since last newline
$lastNl = $before.LastIndexOf("`n")
$col = if ($lastNl -ge 0) { $before.Length - $lastNl } else { $before.Length + 1 }

Write-Host "Approx location:" -ForegroundColor Cyan
Write-Host "  Line   : $line"
Write-Host "  Column : $col"
Write-Host ""

# Show context lines
$lines = $raw -split "`r?`n"
$start = [Math]::Max(1, $line - 3)
$end   = [Math]::Min($lines.Count, $line + 3)

Write-Host "Context:" -ForegroundColor Cyan
for ($i = $start; $i -le $end; $i++) {
  $prefix = if ($i -eq $line) { ">>" } else { "  " }
  "{0} {1,6}: {2}" -f $prefix, $i, $lines[$i-1]
}
Write-Host ""

# Show a short character window around the exact position
$win = 80
$from = [Math]::Max(0, $Position - $win)
$to   = [Math]::Min($raw.Length, $Position + $win)
$snippet = $raw.Substring($from, $to - $from)

Write-Host "Snippet around position $Position:" -ForegroundColor Cyan
Write-Host $snippet
Write-Host ""
Write-Host "Marker:" -ForegroundColor Cyan
Write-Host (" " * ($Position - $from) + "^")
